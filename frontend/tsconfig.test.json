{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* tokens.test.ts reads tokens.css off disk, so this project — and only this
     * project — gets the node globals. */
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-setup.ts",
    "src/test-harness.tsx",
    "src/play/statefixture.ts",
    "src/matches/historyfixture.ts",
    "src/stats/statsfixture.ts"
  ],
  "exclude": []
}
